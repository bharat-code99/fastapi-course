<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    {% if title %}
    FastAPI - {{ title }}
    {% else %}
    FastAPI - Blog
    {% endif %}
  </title>
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body class="text-center space-y-2 p-2">
  <h1 class="text-gray-900 text-3xl font-semibold">Home Page</h1>
  {% for post in posts %}
  <h2 class="text-gray-900 text-2xl font-semibold">{{post.title}}</h2>
  <p class="text-gray-700 text-sm">{{post.content}}</p>
  {% endfor %}
</body>

</html>